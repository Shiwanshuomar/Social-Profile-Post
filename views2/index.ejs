<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylsheet/style.css">
</head>
<body>
    <!-- <div class="main"> -->
    <h1 style="font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;margin: 3px;">Create User</h1>
    <form action="/create" method="post">
        <input type="text" class="input" name="name" placeholder="Name">
        <input type="text" class="input" name="email" placeholder="Email">
         <input type="text" class="input" name="age" placeholder="Age">
        <input type="text" class="input" name="image" placeholder="Image Url">
        <input type="submit" value="Create User"  class="change">
        <a href="/read" id="read" class="change" >Read User</a>
    </form>
    
</body>
</html>